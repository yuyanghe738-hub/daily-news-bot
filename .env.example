# ==================== 邮件配置 ====================
# 方式一：SendGrid API Key（推荐，免费额度 100封/天）
# 注册：https://sendgrid.com/free/
SENDGRID_API_KEY=SG.xxxxx

# 方式二：Gmail SMTP（二选一）
# 需要开启 Gmail 两步验证 + 生成应用专用密码
# https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ==================== 收件人 ====================
TO_EMAIL=yuyanghe738@gmail.com
FROM_EMAIL=news-bot@example.com

# ==================== 抓取天数 ====================
DAYS_BACK=2
